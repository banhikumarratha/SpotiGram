{
  "title": "SpotiGram Services Overview",
  "panels": [
    {
      "title": "API Request Rate (Prometheus)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Circuit Breaker State",
      "type": "stat",
      "targets": [
        {
          "expr": "circuit_breaker_open_total"
        }
      ]
    }
  ]
}
